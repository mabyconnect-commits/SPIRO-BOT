# Required Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Solana Configuration
# Default free RPC (may have rate limits):
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Or use Helius RPC (recommended, faster, higher limits):
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

SOLANA_WALLET_PRIVATE_KEY=your_base58_private_key_here_for_real_trading

# Optional API Keys (Free tiers available)
# Get Helius free key at: https://www.helius.dev/ (recommended for better performance)
HELIUS_API_KEY=
# Get Birdeye free key at: https://birdeye.so/ (provides security checks and metrics)
BIRDEYE_API_KEY=

# Trading Configuration
PAPER_TRADING=true
DEFAULT_PRESET=balanced
MAX_POSITION_SIZE_SOL=1.0
SLIPPAGE_BPS=100

# Scanner Configuration
SCAN_INTERVAL_MS=60000
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=50000

# Pattern Learning
LEARNING_ENABLED=true
MIN_PATTERN_CONFIDENCE=0.6
ANTI_DRIFT_THRESHOLD=0.15

# Database
DB_PATH=./data/alpha-hunter.db

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/alpha-hunter.log
